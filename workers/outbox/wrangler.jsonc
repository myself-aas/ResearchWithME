/**
 * Dedicated Cloudflare Worker for v3.4 Transactional Outbox Delivery
 * (Wave 18 P1 — Cloudflare Queues + Dead-Letter Queue + Cron Fallback).
 *
 * Kept separate from the root site `wrangler.jsonc` (matching `workers/assistant`)
 * so Free-Plan PR previews deploy cleanly without requiring Queue bindings on the
 * site Worker. Provision queues and secrets before deploying:
 *   npx wrangler queues create researchwithme-outbox
 *   npx wrangler queues create researchwithme-outbox-dlq
 *   npx wrangler secret put CRON_SECRET -c workers/outbox/wrangler.jsonc
 *   npm run worker:outbox:deploy
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "researchwithme-outbox",
	"main": "src/index.ts",
	"account_id": "74d241df16b8aaa80914e3dbb6e16758",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"SITE_ORIGIN": "https://researchwith.me",
		"OUTBOX_CONSUMER_NAME": "cf-outbox-worker",
		"OUTBOX_BATCH_LIMIT": "25"
	},
	"triggers": {
		"crons": ["*/2 * * * *"]
	},
	"queues": {
		"producers": [
			{ "binding": "OUTBOX_QUEUE", "queue": "researchwithme-outbox" }
		],
		"consumers": [
			{
				"queue": "researchwithme-outbox",
				"max_batch_size": 25,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "researchwithme-outbox-dlq"
			}
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
		"traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
	}
}
