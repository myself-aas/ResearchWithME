/**
 * The Assistant Worker. Reached only through the site Worker's `ASSISTANT`
 * service binding (see ../../wrangler.jsonc); it has no route, no workers.dev
 * hostname and no preview URL.
 *
 * Deploy this before the site Worker: the site's binding names it.
 *   npm run worker:assistant:deploy
 *   npx wrangler secret put GEMINI_API_KEY -c workers/assistant/wrangler.jsonc
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "researchwithme-assistant",
	"main": "src/index.ts",
	"account_id": "74d241df16b8aaa80914e3dbb6e16758",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	// Readable frames if this Worker is ever profiled (workers-profiling).
	"upload_source_maps": true,
	"vars": {
		// Same default as lib/assistant/generate.ts. Override per deployment.
		"GEMINI_MODEL": "gemini-3.8-flash"
		// Optional: "AI_GATEWAY_BASE_URL": "<AI Gateway endpoint for the provider>"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
		"traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
	}
}
