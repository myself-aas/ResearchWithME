# Server-only secrets. Set these as Cloudflare Worker secrets in production;
# never commit real values. NEXT_PUBLIC_* values are compiled into the browser
# bundle at build time, so changing one requires a rebuild and redeploy.

# --- Optional: model-written research assistant and author avatars ---------
# Without GEMINI_API_KEY the assistant returns a deterministic, cited answer
# assembled from the local catalogue.
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash when unset.
GEMINI_MODEL=

# --- Optional: transactional email (Resend) --------------------------------
# Without this every send is skipped rather than failing. A runtime secret, so
# in production use `wrangler secret put RESEND_API_KEY`, not a build variable.
RESEND_API_KEY=
# Sending addresses are not configured here: each scenario declares its own
# "Name <address@researchwith.me>" sender in lib/email/scenarios.ts, and
# sendScenario refuses to send from anything off that domain.
# Optional, one per scenario. When set, that scenario is sent as an uploaded
# Resend template and Resend renders it, so editors can adjust the design
# visually. When unset -- the default -- the same component in emails/ is
# rendered here and sent as HTML plus a plain-text part. Populate them with
# `npm run email:template:sync`, which prints one `wrangler secret put` per
# scenario. See docs/email-scenarios.md.
RESEND_TPL_WELCOME=
RESEND_TPL_VERIFY_EMAIL=
RESEND_TPL_PASSWORD_RESET=
RESEND_TPL_SECURITY_ALERT=
RESEND_TPL_SUPPORT_REPLY=

# --- Public, build-time values ---------------------------------------------
# Canonical origin for metadata, sitemap, robots, and same-origin checks.
# Defaults to https://researchwith.me.
NEXT_PUBLIC_SITE_URL=
# Project URL and publishable key. Both enable the Supabase CMS, auth,
# storage, and realtime; without them the app runs in local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional: cache-eviction webhook --------------------------------------
# Shared secret for POST /api/revalidate, sent as the x-revalidate-secret
# header. The legacy name MY_SECRET_TOKEN is still accepted.
REVALIDATE_SECRET=

# --- Billing / receipts ---------------------------------------------------
# ResearchWithMe has no paid tiers, subscriptions, or invoicing at launch.
# No STRIPE_*, PADDLE_*, BILLING_*, or RECEIPT_* variables are read anywhere
# in the codebase; adding a payment provider will require a dedicated
# integration and its own scenario in lib/email/scenarios.ts. Do not add
# billing keys here until that work ships.

# --- Local development and deploy tooling (never needed in production) -----
# Overrides the directory the local CMS JSON adapter reads and writes (drafts,
# published posts, and comments for local/demo mode). Defaults to
# <project root>/data. The test suite uses a temporary directory.
RWM_DATA_DIR=
# `npm run deploy` and `npm run upload` refuse to build a Worker that would
# ship without a working CMS. Set to 1 to deploy demo mode deliberately.
ALLOW_DEMO_DEPLOY=

# --- Cloudflare Pages runtime (Pages build & deploy only) ------------------
# Runtime bindings for the Pages Functions; set as Pages environment variables
# / secrets, never as build-time values. The Pages build inlines ONLY the
# four NEXT_PUBLIC_* values above (plus RWM_BUILD_TARGET); nothing else is
# compiled into browser assets.
# KV namespace used by the fixed-window rate limiter. Without a binding the
# limiter falls back to a per-isolate memory store.
RATE_LIMIT_KV=
# 'preview' or 'production'. Effective production requires this AND a build
# made with RWM_BUILD_TARGET=production; any mismatch serves as preview.
# A misconfigured effective-production deployment fails closed with 503.
RWM_DEPLOY_ENV=
# Build-time only. 'local' (default) | 'test' | 'preview' | 'production'.
RWM_BUILD_TARGET=
