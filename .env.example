# Server-only secrets. Set these as Cloudflare Worker secrets in production;
# never commit real values. NEXT_PUBLIC_* values are compiled into the browser
# bundle at build time, so changing one requires a rebuild and redeploy.

# --- Optional: model-written research assistant and author avatars ---------
# Without GEMINI_API_KEY the assistant returns a deterministic, cited answer
# assembled from the local catalogue.
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash when unset.
GEMINI_MODEL=

# --- Optional: Hugging Face Space for generated cover images ---------------
# Private ZeroGPU Space name, e.g. username/qwen2-space.
HF_SPACE_NAME=
HF_TOKEN=

# --- Optional: transactional email (Resend) --------------------------------
# Without BOTH of these every send is skipped: submissions are still recorded,
# they just get no acknowledgement. RESEND_API_KEY is a runtime secret, so in
# production use `wrangler secret put RESEND_API_KEY`, not a build variable.
RESEND_API_KEY=
# Sender address on a domain you verified in the Resend dashboard. Resend's
# shared onboarding@resend.dev sandbox is deliberately not used as a fallback,
# because a receipt from it would land in spam and look like phishing.
EMAIL_FROM=
# Optional. When set, the submission receipt is sent as an uploaded Resend
# template (`npx email resend setup`, then upload) and Resend renders it, so
# editors can adjust the design in the visual editor. When unset -- the default
# -- the same component in emails/ is rendered here and sent as HTML plus a
# plain-text part. Note that the template path cannot carry a plain-text
# alternative: Resend's template variant is mutually exclusive with text.
RESEND_RECEIPT_TEMPLATE_ID=

# --- Public, build-time values ---------------------------------------------
# Canonical origin for metadata, sitemap, robots, and same-origin checks.
# Defaults to https://researchwith.me.
NEXT_PUBLIC_SITE_URL=
# Project URL and publishable key. Both enable the Supabase CMS, auth,
# storage, and realtime; without them the app runs in local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional: cache-eviction webhook --------------------------------------
# Shared secret for POST /api/revalidate, sent as the x-revalidate-secret
# header. The legacy name MY_SECRET_TOKEN is still accepted.
REVALIDATE_SECRET=

# --- Local development and deploy tooling (never needed in production) -----
# Overrides the directory the local JSON adapters read and write. Defaults to
# <project root>/data. The test suite uses a temporary directory.
RWM_DATA_DIR=
# `npm run deploy` and `npm run upload` refuse to build a Worker that would
# ship without a working CMS. Set to 1 to deploy demo mode deliberately.
ALLOW_DEMO_DEPLOY=
