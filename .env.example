# Optional: enables model-written answers in the research assistant.
# Without it the assistant returns a deterministic, cited answer from the catalog.
GEMINI_API_KEY=""

# Optional: Gemini model id. Defaults to gemini-2.5-flash.
GEMINI_MODEL="gemini-2.5-flash"

# Canonical origin used by metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://researchwith.me"
