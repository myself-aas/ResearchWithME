# ---------------------------------------------------------------------------
# ResearchWithMe environment
# Copy to .env.local and fill in what you need. Everything is optional: with no
# Supabase credentials the app runs in local demo mode and the CMS persists to
# data/cms-posts.json and data/cms-comments.json.
# ---------------------------------------------------------------------------

# Canonical origin used by metadata, sitemap.xml, robots.txt, and origin checks.
NEXT_PUBLIC_SITE_URL="https://researchwith.me"

# --- Supabase editorial studio ---------------------------------------------
# Project URL and the *anon* key. Both are public by design and protected by RLS.
# NEXT_PUBLIC_* values are inlined at build time, so rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Shared secret for POST /api/revalidate (Supabase database webhook).
# Send it as the `x-revalidate-secret` header, never in the URL.
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=""

# --- Optional: model-written research assistant answers ---------------------
# Without a key the assistant returns a deterministic, cited answer from the
# bundled catalogue.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
