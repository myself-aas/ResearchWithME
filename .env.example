# Copy to .env.local for local overrides. Every value is public: NEXT_PUBLIC_*
# variables are compiled into the browser bundle and the static build.

# Canonical origin used for metadata, canonical links, the sitemap, and RSS.
# Defaults to https://researchwith.me when unset.
NEXT_PUBLIC_SITE_URL=https://researchwith.me

# Assistant Cloud frontend API for /assistant thread sync (publishable URL —
# the browser mints its own anonymous session tokens from it; no secret here).
# Leave unset to keep assistant threads in-memory and fully on-device.
NEXT_PUBLIC_ASSISTANT_BASE_URL=
