# Raw output of the codebase-knowledge scan; docs/codebase/ holds the 7 distilled
# documents, not the generated dump they were derived from.
docs/codebase/.codebase-scan.txt

# Cloudflare Workers (OpenNext) build output and local secrets.
.open-next/
.wrangler/
# Legacy Cloudflare Pages build output. dist/ is already ignored above; .server/
# is the SSR bundle the old Vite/React Router build wrote beside it.
cloudflare-pages/.server/
# Generated by `npm run cf-typegen`; ~600 KB of workerd runtime types.
cloudflare-env.d.ts
# `npm run email:export` output, and the built React Email preview app. Both are
# derived from emails/ and regenerable.
.email-export/
.react-email/
.dev.vars*
!.dev.vars.example

# Playwright test artifacts.
test-results/
playwright-report/
playwright-report-v34/

# Supabase CLI local state (version check, temp files).
supabase/.temp/

workers/assistant/worker-configuration.d.ts
*.whl
__pycache__/
*.py[cod]

# Superpowers SDD workspace (scratch, per subagent-driven-development skill)
.superpowers/
