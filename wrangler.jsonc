{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "researchwithme",
	// Ashif Ahmed Shuvo's account, so a local `wrangler deploy` and the
	// dashboard build hit the same Worker.
	"account_id": "74d241df16b8aaa80914e3dbb6e16758",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Cloudflare custom domains on this Worker. `wrangler deploy` provisions the
	// DNS records and the edge certificate for each host itself, and `www` serves
	// the same Worker rather than redirecting.
	//
	// A hostname can only belong to one thing. If `researchwith.me` is still
	// attached to the old Pages project the deploy fails on a domain conflict
	// until that project releases it, so check DNS -> Records for a `*.pages.dev`
	// target before the first production deploy. Whether the hostname is held by
	// Pages or by a plain proxied record is not distinguishable from outside the
	// account -- both present as Cloudflare-proxied A/AAAA -- so do not infer it
	// from a DNS lookup.
	//
	// Canonical links use NEXT_PUBLIC_SITE_URL, the apex.
	"routes": [
		{ "pattern": "researchwith.me", "custom_domain": true },
		{ "pattern": "www.researchwith.me", "custom_domain": true }
	],
	"services": [
		{
			// Self-reference used by OpenNext's cache; must match "name" above.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "researchwithme"
		}
	],
	// Free-plan setup: no R2 or Images bindings, so next/image serves originals.
	// One KV namespace (researchwithme-opennext-cache) backs both OpenNext
	// caches; their key prefixes don't overlap (see open-next.config.ts).
	// RATE_LIMIT_KV points at the same namespace with its own `rl:` prefix
	// (lib/rate-limit.ts). Sharing it means rate-limiter writes draw on the same
	// free 1,000-writes-a-day budget as the page cache; to separate them, run
	// `npx wrangler kv namespace create researchwithme-rate-limit` and use that id
	// for RATE_LIMIT_KV only. Without any RATE_LIMIT_KV binding the limiter
	// silently falls back to a per-isolate in-memory count.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" },
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" },
		{ "binding": "RATE_LIMIT_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" }
	],
	// Worker Previews (`wrangler preview`) — what Cloudflare's build runs for a
	// pull request. A preview is a branch of the Worker, not the production
	// instance, so it does not inherit the bindings above; anything it needs has
	// to be named again here, or the preview deploy stops with
	// "Your Wrangler configuration is missing a `previews` block".
	//
	// These point at the production namespace deliberately. OpenNext scopes every
	// key by build id, so a preview's entries are unreachable from production and
	// vice versa: the incremental cache stores
	// `incremental-cache/<buildId>/<sha256>.cache`
	// (node_modules/@opennextjs/cloudflare/dist/api/overrides/incremental-cache/
	// kv-incremental-cache.js) and the tag cache stores `<buildId>/<tag>`
	// (…/tag-cache/kv-next-tag-cache.js). What the two do share is the free
	// plan's 1,000 KV writes a day; to split that as well, create a second
	// namespace and swap the ids here — see README, "Worker Previews".
	//
	// `WORKER_SELF_REFERENCE` is deliberately absent: Worker Previews do not
	// support service bindings, so a preview renders and caches but does not
	// re-render itself through OpenNext's queue.
	"previews": {
		"kv_namespaces": [
			{ "binding": "NEXT_INC_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" },
			{ "binding": "NEXT_TAG_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" },
			{ "binding": "RATE_LIMIT_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" }
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	}
}
