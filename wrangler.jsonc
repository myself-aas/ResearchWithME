{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "researchwithme",
	// Ashif Ahmed Shuvo's account, so a local `wrangler deploy` and the
	// dashboard build hit the same Worker.
	"account_id": "74d241df16b8aaa80914e3dbb6e16758",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Minify the Worker bundle and disable implicit source-map uploads so both
	// `wrangler deploy` and `wrangler preview` stay under Cloudflare's Free-Plan
	// compressed script limit.
	"minify": true,
	"upload_source_maps": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Cloudflare custom domains on this Worker. `wrangler deploy` provisions the
	// DNS records and the edge certificate for each host, and `www` serves the
	// same Worker rather than redirecting. Canonical links use
	// NEXT_PUBLIC_SITE_URL, the apex.
	"routes": [
		{ "pattern": "researchwith.me", "custom_domain": true },
		{ "pattern": "www.researchwith.me", "custom_domain": true }
	],
	"services": [
		{
			// Self-reference used by OpenNext's cache; must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "researchwithme"
		}
	],
	// One KV namespace backs OpenNext's incremental and tag caches. The blog is
	// fully static, so the cache mostly stores rendered route output; keeping the
	// bindings means a future preview/revalidation needs no config change.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" },
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" }
	],
	// Worker Previews (`wrangler preview`) branch off the Worker and do not
	// inherit bindings, so the KV namespaces are repeated here. Service bindings
	// are not supported in previews, which is why WORKER_SELF_REFERENCE is absent.
	"previews": {
		"kv_namespaces": [
			{ "binding": "NEXT_INC_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" },
			{ "binding": "NEXT_TAG_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" }
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	}
}
