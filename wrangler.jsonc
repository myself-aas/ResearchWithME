{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "researchwithme",
	// Ashif Ahmed Shuvo's account. Kept here so a local `wrangler deploy` and
	// CI deploy the same Worker; CI also sets CLOUDFLARE_ACCOUNT_ID.
	"account_id": "74d241df16b8aaa80914e3dbb6e16758",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Custom domains: Wrangler owns the DNS records for both hosts and creates a
	// proxied AAAA record pointing at 100:: for each. The zone already runs on
	// Cloudflare's nameservers (luciana/evan.ns.cloudflare.com), which is what
	// makes this work. `www` is a second custom domain rather than a redirect,
	// so both hosts serve the same Worker; canonical links use
	// NEXT_PUBLIC_SITE_URL, which stays the apex.
	"routes": [
		{ "pattern": "researchwith.me", "custom_domain": true },
		{ "pattern": "www.researchwith.me", "custom_domain": true }
	],
	// Preview URLs let `wrangler versions upload --preview-alias pr-N` hand back
	// a link without moving production traffic. See .github/workflows/deploy.yml.
	"preview_urls": true,
	"services": [
		{
			// Self-reference used by OpenNext's cache; must match "name" above.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "researchwithme"
		}
	],
	// Free-plan setup: no R2 or Images bindings, so next/image serves originals.
	// One KV namespace backs both OpenNext caches; their key prefixes don't
	// overlap (see open-next.config.ts). Every binding here must resolve or
	// `wrangler deploy` fails, which is why nothing unused is declared.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" },
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "8d2dc8f0b1bb4839962ae63df8296b31" }
	],
	// D1 is deliberately absent: article, comment, and studio data live in
	// Supabase Postgres, and the Worker never opens a D1 database. To add one,
	// run `npx wrangler d1 create researchwithme-db`, then declare it here and
	// bind it in code:
	//
	//   "d1_databases": [
	//     {
	//       "binding": "DB",
	//       "database_name": "researchwithme-db",
	//       "database_id": "<id printed by d1 create>",
	//       "migrations_dir": "supabase/migrations"
	//     }
	//   ]
	//
	// and add the binding to CloudflareEnv (npm run cf-typegen).
	"observability": {
		"enabled": true
	}
}
