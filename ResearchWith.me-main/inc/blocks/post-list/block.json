{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reme/post-list",
	"title": "Post List",
	"category": "text",
	"description": "Displays a list of blog posts filtered by author, category, or tag.",
	"keywords": [ "post", "blog", "list", "archive" ],
	"attributes": {
		"postType": {
			"type": "string",
			"default": "post"
		},
		"author": {
			"type": "string",
			"default": ""
		},
		"category": {
			"type": "string",
			"default": ""
		},
		"tag": {
			"type": "string",
			"default": ""
		},
		"postsPerPage": {
			"type": "number",
			"default": 6
		},
		"showExcerpt": {
			"type": "boolean",
			"default": true
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"showAuthors": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"padding": true,
			"margin": true
		},
		"border": {
			"radius": true,
			"width": true,
			"style": true,
			"color": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"textdomain": "reme",
	"editorScript": "reme-blocks-editor",
	"editorStyle": "reme-blocks-editor",
	"style": "reme-blocks",
	"viewContext": [ "embed", "widget" ]
}
