{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"border": {
			"color": true,
			"radius": true,
			"width": true
		},
		"color": {
			"custom": true,
			"customGradient": false,
			"palette": [
				{
					"color": "var(--rm-primary-accent)",
					"name": "Primary Accent",
					"slug": "primary-accent"
				},
				{
					"color": "var(--rm-secondary-accent)",
					"name": "Secondary Accent",
					"slug": "secondary-accent"
				},
				{
					"color": "var(--rm-site-bg)",
					"name": "Site Background",
					"slug": "site-bg"
				},
				{
					"color": "var(--rm-light-bg)",
					"name": "Light Background",
					"slug": "light-bg"
				},
				{
					"color": "var(--rm-dark-bg)",
					"name": "Dark Background",
					"slug": "dark-bg"
				},
				{
					"color": "var(--rm-text-color)",
					"name": "Text Color",
					"slug": "text-color"
				},
				{
					"color": "var(--rm-text-dark-bg)",
					"name": "Text Dark Background",
					"slug": "text-dark-bg"
				},
				{
					"color": "var(--rm-c-1)",
					"name": "Extra Color 1",
					"slug": "c-1"
				},
				{
					"color": "var(--rm-c-2)",
					"name": "Extra Color 2",
					"slug": "c-2"
				}
			]
		},
		"custom": {
			"spacing": true,
			"spacingScale": true,
			"typography": {
				"lineHeight": true
			}
		},
		"customUnits": true,
		"layout": {
			"contentSize": "1160px",
			"wideSize": "1400px"
		},
		"spacing": {
			"blockGap": true,
			"customMargin": true,
			"customPadding": true,
			"units": ["px", "%", "em", "rem", "vw", "vh"]
		},
		"typography": {
			"customFontSize": true,
			"customLineHeight": true,
			"dropCap": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"name": "System Font",
					"slug": "system-font"
				},
				{
					"fontFamily": "\"Georgia\", \"Times New Roman\", Times, serif",
					"name": "Serif",
					"slug": "serif"
				},
				{
					"fontFamily": "\"Courier New\", Courier, monospace",
					"name": "Monospace",
					"slug": "monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"size": "0.75rem",
					"name": "Extra Small"
				},
				{
					"slug": "sm",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "base",
					"size": "1rem",
					"name": "Base"
				},
				{
					"slug": "lg",
					"size": "1.125rem",
					"name": "Large"
				},
				{
					"slug": "xl",
					"size": "1.25rem",
					"name": "Extra Large"
				},
				{
					"slug": "2xl",
					"size": "1.5rem",
					"name": "2X Large"
				},
				{
					"slug": "3xl",
					"size": "2rem",
					"name": "3X Large"
				}
			],
			"lineHeight": [
				{
					"slug": "tight",
					"lineHeight": 1.25,
					"name": "Tight"
				},
				{
					"slug": "normal",
					"lineHeight": 1.5,
					"name": "Normal"
				},
				{
					"slug": "relaxed",
					"lineHeight": 1.75,
					"name": "Relaxed"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/heading": {
				"typography": {
					"lineHeight": "1.2"
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.7"
				}
			},
			"core/button": {
				"border": {
					"radius": "6px"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
