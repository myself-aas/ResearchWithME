<?xml version="1.0"?>
<ruleset name="ReMe-WPCS">
	<description>WordPress Coding Standards for ReMe theme</description>

	<rule ref="WordPress">
		<!-- Exclude docs from sniffing -->
		<exclude-pattern>*/docs/*</exclude-pattern>
		<exclude-pattern>*/vendor/*</exclude-pattern>
		<exclude-pattern>*/node_modules/*</exclude-pattern>
		<exclude-pattern>*/assets/js/build/*</exclude-pattern>
		<exclude-pattern>*/style-main-new*.css</exclude-pattern>
		<exclude-pattern>*/style-main-new*.min.css</exclude-pattern>
	</rule>

	<!-- WordPress core security: escape output -->
	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Security.NonceVerification"/>

	<!-- WordPress SQL: prepared statements -->
	<rule ref="WordPress.SQL.PreparedPlaceholders"/>

	<!-- WordPress PHP: strict comparison -->
	<rule ref="WordPress.PHP.StrictComparisons"/>

	<!-- WordPress databases: no direct SQL -->
	<rule ref="WordPress.DB.PrepareDatabaseQueries"/>

	<!-- WordPress naming: prefix functions -->
	<rule ref="WordPress.NamingConventions.PrefixAll"/>
</ruleset>
