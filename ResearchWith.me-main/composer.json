{
	"name": "myself-aas/researchwith-me",
	"type": "wordpress-theme",
	"description": "ReMe - WordPress theme for ResearchWithMe, a scholarly publishing platform",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ashif Ahmed Shuvo",
			"email": "ashif@researchwith.me",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0",
		"phpunit/phpunit": "^9.0"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml.dist inc/ plugins/",
		"test": "phpunit"
	}
}
