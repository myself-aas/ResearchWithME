# Canonical origin for metadata, sitemap, RSS, JSON-LD, and canonical links.
# Public: compiled into the build, so changing it requires a rebuild.
NEXT_PUBLIC_SITE_URL=https://researchwith.me

# Assistant Cloud frontend API for /assistant thread sync (project proj_0k1j9pkb7977).
# Publishable by design: the URL is the anonymous client's only credential and the
# browser mint its own session tokens from it. Unset = assistant threads stay
# in-memory and nothing leaves the browser.
NEXT_PUBLIC_ASSISTANT_BASE_URL=https://proj-0k1j9pkb7977.assistant-api.com
