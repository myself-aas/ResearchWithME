{
  "color": {
    "neutral": {
      "0": "#F2F2F7",
      "900": "#1C1C1E"
    },
    "tomato": {
      "500": "#FF3B30"
    },
    "orange": {
      "500": "#FF9F0A"
    },
    "yellow": {
      "500": "#FFD60A"
    }
  },
  "typography": {
    "family": {
      "editorial": "'Newsreader', Georgia, Cambria, \"Times New Roman\", serif",
      "interface": "'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "metadata": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace"
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radius": {
    "xs": "0.25rem",
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "full": "9999px"
  },
  "shadow": {
    "raised": "none",
    "floating": "0 8px 24px rgba(18, 18, 20, 0.08)",
    "dialog": "0 16px 40px rgba(18, 18, 20, 0.14)"
  },
  "layout": {
    "max-width": {
      "reading": "68ch",
      "workspace": "90rem",
      "graph": "108rem"
    },
    "grid": {
      "desktop": {
        "columns": 12,
        "gutter": "1.5rem",
        "margin": "3rem"
      },
      "tablet": {
        "columns": 8,
        "gutter": "1rem",
        "margin": "2rem"
      },
      "mobile": {
        "columns": 4,
        "gutter": "0.75rem",
        "margin": "1rem"
      }
    },
    "breakpoint": {
      "sm": "36rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "80rem",
      "2xl": "96rem"
    },
    "density": [
      "compact",
      "comfortable",
      "spacious"
    ]
  },
  "focus": {
    "width": "2px",
    "offset": "2px",
    "light": "#1C1C1E",
    "dark": "#FF3B30"
  },
  "icon": {
    "small": "1rem",
    "medium": "1.25rem",
    "large": "1.5rem",
    "stroke": "1.75px",
    "style": "simple, geometric, non-decorative"
  },
  "graph": {
    "node": {
      "source": "#FF3B30",
      "evidence": "#FFD60A",
      "claim": "#FF9F0A",
      "discussion": "#FFD60A",
      "publication": "#FF9F0A",
      "archived": "#1C1C1E"
    },
    "edge": {
      "cites": "#FF3B30",
      "supports": "#FFD60A",
      "contradicts": "#FF3B30",
      "derives": "#FF9F0A",
      "relates": "#1C1C1E",
      "direct-style": "solid",
      "inferred-style": "dashed"
    }
  }
}
