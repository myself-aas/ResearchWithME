{
  "color": {
    "canvas": "#FAF9F6",
    "surface": "#F3F1EC",
    "surface-subtle": "#EAE7DF",
    "text-primary": "#121214",
    "text-secondary": "#5C5C63",
    "action": {
      "primary": "#1D4ED8",
      "primary-hover": "#1E40AF",
      "primary-pressed": "#1E3A8A",
      "on-primary": "#FFFFFF",
      "destructive": "#B91C1C",
      "link": "#1D4ED8",
      "visited": "#1E40AF"
    },
    "focus": "#1D4ED8"
  },
  "surface": {
    "background": "#F3F1EC",
    "raised": "#FAF9F6"
  },
  "text": {
    "primary": "#121214",
    "secondary": "#5C5C63",
    "onAction": "#FFFFFF"
  },
  "font": {
    "latin": {
      "editorial": "'Newsreader', Georgia, serif",
      "interface": "'Inter', system-ui, sans-serif",
      "metadata": "'JetBrains Mono', monospace"
    },
    "bengali": {
      "editorial": "'Noto Serif Bengali', 'Hind Siliguri', serif",
      "interface": "'Noto Serif Bengali', 'Hind Siliguri', 'Noto Sans Bengali', sans-serif",
      "metadata": "'Noto Serif Bengali', 'Hind Siliguri', 'Noto Sans Bengali', sans-serif"
    },
    "arabic": {
      "editorial": "'Noto Naskh Arabic', serif",
      "interface": "'Noto Sans Arabic', sans-serif"
    }
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "standard": "200ms",
      "deliberate": "320ms",
      "connect": "480ms",
      "synthesize": "700ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)",
      "emphasize": "cubic-bezier(0.2, 0.8, 0.2, 1)"
    },
    "patterns": {
      "reveal": "standard",
      "connect": "connect",
      "verify": "deliberate",
      "synthesize": "synthesize",
      "archive": "deliberate"
    },
    "modes": {
      "0": "full",
      "1": "reduced",
      "2": "static"
    },
    "renderer": {
      "interface": "css",
      "react-video": "remotion",
      "web-video": "hyperframes"
    },
    "video": {
      "fps": {
        "standard": 30,
        "high-motion": 60
      },
      "resolution": {
        "landscape-hd": "1920x1080",
        "portrait-hd": "1080x1920",
        "square": "1080x1080"
      },
      "scene": {
        "minimum": "2.5s",
        "standard": "5s",
        "evidence-dense": "8s",
        "citation-end-card": "5s"
      },
      "frames-at-30fps": {
        "transition-fast": 8,
        "transition-standard": 12,
        "transition-deliberate": 18
      }
    }
  },
  "layout": {
    "max-width": {
      "reading": "68ch",
      "workspace": "90rem",
      "graph": "108rem"
    },
    "grid": {
      "desktop": {
        "columns": 12,
        "gutter": "1.5rem",
        "margin": "3rem"
      },
      "tablet": {
        "columns": 8,
        "gutter": "1rem",
        "margin": "2rem"
      },
      "mobile": {
        "columns": 4,
        "gutter": "0.75rem",
        "margin": "1rem"
      }
    },
    "breakpoint": {
      "sm": "36rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "80rem",
      "2xl": "96rem"
    },
    "density": {
      "0": "compact",
      "1": "comfortable",
      "2": "spacious"
    }
  }
}
