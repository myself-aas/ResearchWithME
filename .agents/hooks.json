{
  "description": "Impeccable design detector: full-rule checks after UI edits and a deep pass when the turn ends.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\".agents/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "cmd /c if exist \".agents\\skills\\impeccable\\scripts\\impeccable.cmd\" \".agents\\skills\\impeccable\\scripts\\impeccable.cmd\" hook",
            "timeout": 10,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\".agents/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "cmd /c if exist \".agents\\skills\\impeccable\\scripts\\impeccable.cmd\" \".agents\\skills\\impeccable\\scripts\\impeccable.cmd\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          },
          {
            "type": "command",
            "command": "node scripts/pieme-check.mjs --changed",
            "timeout": 10,
            "statusMessage": "Checking changed πeme article drafts (no network or writes)"
          }
        ]
      }
    ]
  }
}
