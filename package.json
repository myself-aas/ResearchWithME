{
  "name": "researchwithme",
  "version": "0.2.2",
  "private": true,
  "description": "Long-form reviews of published papers and open repositories, written by verified domain specialists. Every claim carries a citation, every artifact has a home, and nothing sits behind a paywall.",
  "homepage": "https://github.com/myself-aas/ResearchWithME#readme",
  "bugs": {
    "url": "https://github.com/myself-aas/ResearchWithME/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myself-aas/ResearchWithME.git"
  },
  "license": "ISC",
  "author": "Ashif Ahmed Shuvo",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "node scripts/build-next-or-worker.mjs",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "predeploy": "node scripts/check-production-env.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preupload": "node scripts/check-production-env.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "worker:assistant:dev": "wrangler dev -c workers/assistant/wrangler.jsonc",
    "worker:assistant:check": "wrangler types -c workers/assistant/wrangler.jsonc workers/assistant/worker-configuration.d.ts && tsc -p workers/assistant && wrangler deploy --dry-run -c workers/assistant/wrangler.jsonc --outdir .wrangler/assistant-dry-run",
    "worker:assistant:deploy": "wrangler deploy -c workers/assistant/wrangler.jsonc",
    "worker:outbox:check": "tsc -p workers/outbox && wrangler deploy --dry-run -c workers/outbox/wrangler.jsonc --outdir .wrangler/outbox-dry-run",
    "worker:outbox:deploy": "wrangler deploy -c workers/outbox/wrangler.jsonc",
    "cloudflare:provision:dry": "node scripts/provision-cloudflare-v34.mjs --dry-run --deploy-workers",
    "storage:provision:supabase": "node scripts/provision-supabase-storage-v34.mjs",
    "storage:check:supabase": "node scripts/provision-supabase-storage-v34.mjs --check",
    "env:check:v34": "node scripts/check-production-env.mjs --v34-cutover",
    "verify:v34:cutover": "node scripts/verify-v34-cutover.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "email:dev": "email dev -d emails -p 3001",
    "email:export": "email export -d emails --outDir .email-export",
    "email:resend:setup": "email resend setup",
    "email:template:sync": "tsx scripts/sync-templates.ts",
    "email:verify": "tsx scripts/verify-emails.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:linkedin": "vitest run lib/linkedin/__tests__/",
    "test:linkedin:watch": "vitest lib/linkedin/__tests__/",
    "test:e2e:linkedin": "playwright test --config test/playwright.linkedin.config.ts",
    "test:e2e:v34": "playwright test --config test/playwright.v34.config.ts",
    "verify:v34:live": "node scripts/verify-v34-live.mjs",
    "test:all": "npm run test && npm run test:linkedin",
    "tokens:build": "node tokens/scripts/build.mjs",
    "tokens:check": "node tokens/scripts/validate.mjs && node tokens/scripts/check-contrast.mjs && node tokens/scripts/check-consumers.mjs",
    "quality": "npm run tokens:build && npm run tokens:check && npm run lint && npm run typecheck && npm run test && npm run dns:test && npm run webmcp:test && npm run impeccable:source && npm run worker:assistant:check && npm run worker:outbox:check",
    "impeccable:source": "impeccable detect app components",
    "impeccable:url": "impeccable detect --json --no-advisory --viewport 1280x800 http://localhost:3000",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "deploy-guard": "node scripts/check-production-env.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "capture:next-contract": "tsx scripts/capture-next-contract.ts",
    "docs:workflows": "tsx scripts/build-workflow-docs.ts",
    "reme:check": "node scripts/reme-check.mjs --all",
    "reme:test": "node --test test/reme-check.test.mjs test/reme-name.test.mjs",
    "dns:test": "node --test test/dns-aid.test.mjs test/verify-dns-aid.test.mjs",
    "webmcp:test": "node --test test/webmcp.test.mjs",
    "preinstall": "node scripts/ensure-npm.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "1.20.14",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/link": "^53.3.5",
    "@platejs/list": "^53.3.13",
    "@platejs/markdown": "^53.5.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "^2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lottie-web": "5.13.0",
    "lucide-react": "^0.553.0",
    "motion": "^14.12.0",
    "next": "15.5.28",
    "platejs": "^53.5.2",
    "postcss": "^8.5.31",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-easy-crop": "6.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "split-type": "^0.3.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "unified": "^11.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/pages-plugin-vercel-og": "^0.1.2",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "daisyui": "^5.8.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "impeccable": "^4.7.0",
    "jsdom": "^31.0.0",
    "react-email": "6.11.8",
    "react-router-dom": "^6.30.6",
    "supabase": "^3.1.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "7.3.8",
    "vitest": "^3.2.4",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    }
  },
  "packageManager": "npm@10.9.8"
}
