{
  "name": "researchwithme",
  "version": "1.2.0",
  "private": true,
  "description": "A single-author blog. Essays on research papers and open-source code, written in MDX and published from git.",
  "homepage": "https://researchwith.me",
  "bugs": {
    "url": "https://github.com/myself-aas/ResearchWithME/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myself-aas/ResearchWithME.git"
  },
  "license": "ISC",
  "author": "Ashif Ahmed Shuvo",
  "type": "commonjs",
  "directories": {
    "doc": "content",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "node scripts/build-next-or-worker.mjs",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "predeploy": "node scripts/check-production-env.mjs",
    "preupload": "node scripts/check-production-env.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "new": "node scripts/new-post.mjs",
    "figures:new": "node scripts/new-figure.mjs",
    "tokens:build": "node tokens/scripts/build.mjs",
    "tokens:check": "node tokens/scripts/validate.mjs && node tokens/scripts/check-contrast.mjs",
    "quality": "npm run content:verify && npm run design:check && npm run tokens:build && npm run tokens:check && npm run lint && npm run typecheck && npm run test",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "preinstall": "node scripts/ensure-npm.mjs",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run build && npm run check:site",
    "serve": "node scripts/standalone-serve.mjs",
    "check:mcp": "node .agents/mcp/verify.mjs",
    "design:gen": "tsx scripts/design/gen.ts",
    "design:verify": "tsx scripts/design/gen.ts --verify",
    "design:lint": "tsx scripts/design/lint.ts",
    "design:check": "npm run design:verify && npm run design:lint",
    "prebuild": "npm run content:verify && npm run design:check && npm run tokens:build",
    "design:browser": "playwright test --config playwright.design.config.ts",
    "design:payload": "tsx scripts/design/payload.ts",
    "design:lint:all": "tsx scripts/design/audit-source.ts",
    "audit:all": "node scripts/design/audit-all.mjs",
    "test:production": "node scripts/design/smoke-production.mjs",
    "content:gen": "tsx scripts/content/snapshot.ts",
    "content:verify": "tsx scripts/content/snapshot.ts --verify",
    "check:worker": "node scripts/workers/check-build.mjs",
    "test:worker": "node scripts/workers/smoke.mjs",
    "verify:worker": "npm run build:worker && npm run check:worker && npm run test:worker"
  },
  "dependencies": {
    "@assistant-ui/generative-ui": "^0.0.13",
    "@assistant-ui/next": "^0.0.26",
    "@assistant-ui/react": "^0.15.38",
    "@assistant-ui/react-markdown": "^0.14.26",
    "@opennextjs/cloudflare": "1.20.14",
    "fuse.js": "^7.5.0",
    "generative-frame": "^0.0.12",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.553.0",
    "next": "15.5.28",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/eslintrc": "^3.3.7",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@10.9.8"
}
