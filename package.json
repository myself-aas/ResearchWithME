{
  "name": "researchwithme",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run impeccable:source",
    "impeccable:source": "impeccable detect app components",
    "impeccable:url": "impeccable detect --json --no-advisory --viewport 1280x800 http://localhost:3000",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "videos:manifest": "node scripts/build-video-manifest.mjs",
    "predev": "npm run videos:manifest",
    "prebuild": "npm run videos:manifest",
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase:bundle": "node scripts/bundle-migrations.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@gradio/client": "^2.7.1",
    "@mdxeditor/editor": "^4.3.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "next": "15.5.28",
    "postcss": "^8.5.31",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "1.20.14",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "impeccable": "^4.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    }
  }
}
