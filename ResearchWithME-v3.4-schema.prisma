generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Visibility { PUBLIC WORKSPACE PRIVATE }
enum VerificationState { UNVERIFIED SELF_DECLARED PENDING VERIFIED REJECTED }
enum ExpertiseKind { RESEARCH_INTEREST METHOD TOOL DOMAIN }
enum ExpertiseLevel { LEARNING PRACTITIONER ADVANCED EXPERT }
enum DashboardPersona { READER CONTRIBUTOR REVIEWER RESEARCHER DEVELOPER EDITOR }
enum ModuleVisibility { VISIBLE COLLAPSED HIDDEN }
enum ModuleSize { SMALL MEDIUM LARGE FULL }
enum DataClassification { PUBLIC WORKSPACE CONFIDENTIAL RESTRICTED EMBARGOED }
enum WorkspaceRole { OWNER ADMIN EDITOR CONTRIBUTOR REVIEWER VIEWER }
enum WorkspaceStatus { ACTIVE SUSPENDED ARCHIVED }
enum LibraryObjectType { SOURCE TOOL DATASET CONTRIBUTION NOTE CLAIM EVIDENCE }
enum ReadState { UNREAD IN_PROGRESS COMPLETED ARCHIVED }
enum ProjectStatus { ACTIVE PAUSED COMPLETED ARCHIVED }
enum ProjectStage { DISCOVERY LITERATURE_REVIEW EVIDENCE_SYNTHESIS DRAFTING REVIEW PUBLICATION }
enum ProjectRole { OWNER EDITOR CONTRIBUTOR REVIEWER VIEWER }
enum TaskStatus { TODO IN_PROGRESS BLOCKED COMPLETED CANCELLED }
enum TaskPriority { LOW MEDIUM HIGH URGENT }
enum ProjectObjectType { SOURCE EVIDENCE CLAIM NOTE DRAFT CONTRIBUTION DATASET TOOL REVIEW }
enum ReputationEventType { CONTRIBUTION_REFERENCED REVIEW_MARKED_HELPFUL EVIDENCE_REUSED CORRECTION_ACCEPTED REPLICATION_REPORTED REVIEW_COMPLETED }
enum AttentionKind { INTEGRITY SYNC REVIEW CITATION PERMISSION DEADLINE ASSISTANT }
enum AttentionSeverity { INFO WARNING HIGH CRITICAL }
enum AttentionStatus { OPEN ACKNOWLEDGED RESOLVED DISMISSED }
enum NotificationType { CONTRIBUTION_REFERENCED CONTRIBUTION_SAVED REVIEW_REQUESTED REVIEW_RESPONSE INTEGRITY_CORRECTION INTEGRITY_RETRACTION CITATION_UNRESOLVED PROJECT_INVITATION PROJECT_UPDATE ASSISTANT_TASK SYNC_CONFLICT }
enum NotificationChannel { IN_APP EMAIL PUSH }
enum NotificationDeliveryStatus { PENDING SENT FAILED SKIPPED }
enum SourceType { ARTICLE DATASET BOOK CHAPTER PREPRINT SOFTWARE PROTOCOL WEBPAGE REPORT THESIS }
enum SourceIntegrity { ACTIVE CORRECTED EXPRESSION_OF_CONCERN RETRACTED WITHDRAWN }
enum IdentifierScheme { DOI ORCID PMID PMCID ISBN ISSN ARXIV HANDLE ROR RRID ACCESSION URL }
enum IdentifierResolutionStatus { RESOLVED UNRESOLVED INVALID TEMPORARILY_UNAVAILABLE }
enum ClaimType { DESCRIPTIVE COMPARATIVE CAUSAL PREDICTIVE NORMATIVE METHODOLOGICAL }
enum ContributionType { PAPER_REVIEW TOOL_REVIEW PERSPECTIVE RESEARCH_NOTE DATASET_REVIEW REPLICATION_REPORT RESEARCH_QUESTION LITERATURE_SUMMARY METHOD_REVIEW IMPLEMENTATION_NOTE }
enum ContributionStatus { IDEA DRAFT REVIEW_REQUIRED UNDER_REVIEW APPROVED PUBLISHED SUPERSEDED ARCHIVED WITHDRAWN }
enum RelationshipType { CITES SUPPORTS CONTRADICTS QUALIFIES REPLICATES PARTIALLY_REPLICATES FAILS_TO_REPLICATE CORRECTS RETRACTS DERIVES_FROM SUPERSEDES REVIEWS RESPONDS_TO USES_DATASET USES_SOFTWARE }
enum RelationshipAssertionMethod { MANUAL IMPORTED AI_SUGGESTED }
enum RelationshipStatus { PROPOSED ACCEPTED CONTESTED WITHDRAWN }
enum ReviewRecommendation { SUPPORT MIXED OPPOSE }
enum ReviewStatus { REQUESTED IN_PROGRESS SUBMITTED RESPONDED ACCEPTED REJECTED CLOSED CANCELLED }
enum ReviewItemStatus { OPEN ADDRESSED ACCEPTED REJECTED RESOLVED }
enum DecisionOutcome { ACCEPT REVISE REJECT WITHDRAW }
enum AIOperationType { SEARCH EXTRACT SUMMARIZE COMPARE DRAFT TRANSLATE CLASSIFY }
enum AITransformationType { QUOTED EXTRACTED CALCULATED INFERRED GENERATED TRANSLATED SYNTHETIC }
enum CitationResolutionStatus { RESOLVED PARTIALLY_RESOLVED UNRESOLVED }
enum CitationEntailment { SUPPORTS PARTIALLY_SUPPORTS DOES_NOT_SUPPORT NOT_ASSESSED }
enum QuotationMatchStatus { EXACT NORMALIZED_MATCH MISMATCH NOT_APPLICABLE }
enum HumanReviewStatus { NOT_REVIEWED CHANGES_REQUESTED APPROVED REJECTED }
enum ExternalProcessingPolicy { LOCAL_ONLY APPROVED_PROVIDER RESTRICTED PROHIBITED }
enum SaveState { EDITING SAVING SAVED SYNCED OFFLINE CONFLICT FAILED }
enum EditorBlockType { PARAGRAPH HEADING SOURCE EVIDENCE CLAIM CITATION LIMITATION REVIEW QUESTION TOOL_REVIEW }
enum DraftStatus { ACTIVE CONFLICT ARCHIVED PUBLISHED DELETED }
enum SnapshotReason { INTERVAL MANUAL PRE_PUBLISH CONFLICT RESTORE }
enum MutationStatus { PENDING PROCESSING SUCCEEDED FAILED CONFLICT CANCELLED }
enum IntegrityEventType { CORRECTION EXPRESSION_OF_CONCERN RETRACTION WITHDRAWAL REPLACEMENT }
enum IntegrityImpact { UNAFFECTED REVIEW_REQUIRED POTENTIALLY_AFFECTED MATERIALLY_AFFECTED WITHDRAWN }
enum IntegrityImpactStatus { OPEN REVIEWING RESOLVED WAIVED }
enum ReviewLevel { NOT_REVIEWED EDITORIALLY_REVIEWED PEER_REVIEWED }
enum ReplicationLevel { NOT_ASSESSED REPLICATED PARTIALLY_REPLICATED FAILED_TO_REPLICATE }
enum CertaintyLevel { VERY_LOW LOW MODERATE HIGH }
enum ConsensusLevel { UNKNOWN EMERGING MIXED BROAD CONTESTED }
enum AnnotationType { HIGHLIGHT COMMENT QUESTION CORRECTION EVIDENCE }
enum AnnotationStatus { ACTIVE UNRESOLVED RESOLVED ORPHANED ARCHIVED }
enum AssistantTaskType { RESOLVE_CITATION COMPARE_SOURCES REVIEW_CLAIM DRAFT_CONTRIBUTION CHECK_INTEGRITY TRANSLATE SUMMARIZE }
enum AssistantTaskStatus { PENDING IN_PROGRESS COMPLETED DISMISSED FAILED }
enum ToolRepositoryHost { GITHUB GITLAB OTHER }
enum ToolReviewRecommendation { RECOMMEND CONDITIONAL NOT_RECOMMENDED }
enum AuditOutcome { SUCCESS DENIED FAILED }
enum AuditAction { VIEW_RESTRICTED CHANGE_CLASSIFICATION GRANT_ACCESS REVOKE_ACCESS EXPORT_DATA PUBLISH_VERSION APPROVE_AI_CONTENT CHANGE_EMBARGO REDACT_CONTENT RENDER_NON_PUBLIC DELETE_OBJECT RESTORE_OBJECT }


enum ClaimEvidenceType { SUPPORTS CONTRADICTS QUALIFIES }
enum TopicRelationType { BROADER_THAN NARROWER_THAN RELATED_TO EQUIVALENT_TO }
enum DiscussionCommentStatus { ACTIVE EDITED HIDDEN REMOVED ARCHIVED }
enum ResearchGoalMetric { SOURCES_REVIEWED CONTRIBUTIONS_PUBLISHED REVIEWS_COMPLETED EVIDENCE_ATTACHED CITATIONS_RESOLVED MILESTONES_COMPLETED REPLICATIONS_DOCUMENTED CUSTOM }
enum ResearchGoalPeriod { ONE_TIME WEEKLY MONTHLY QUARTERLY CUSTOM }
enum ResearchGoalStatus { ACTIVE PAUSED COMPLETED EXPIRED ARCHIVED }
enum AlertFrequency { IMMEDIATE DAILY WEEKLY MONTHLY }
enum GraphNodeType { SOURCE EVIDENCE CLAIM CONTRIBUTION TOOL PROJECT TOPIC REVIEW }
enum BackgroundJobStatus { PENDING RUNNING SUCCEEDED FAILED CANCELLED }
enum WebhookDeliveryStatus { RECEIVED PROCESSING SUCCEEDED FAILED IGNORED }
enum OutboxEventStatus { PENDING PUBLISHED FAILED }

// ============================================================
// IDENTITY, PROFILES, WORKSPACES
// ============================================================

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  emailVerifiedAt    DateTime?
  name               String?
  image              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  profile            UserProfile?
  ownedWorkspaces    Workspace[] @relation("WorkspaceOwner")
  workspaceMembers   WorkspaceMember[]
  ownedProjects      ResearchProject[] @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  assignedTasks      ProjectTask[] @relation("TaskAssignee")
  createdTasks       ProjectTask[] @relation("TaskCreator")
  contributions      Contribution[] @relation("ContributionAuthor")
  contributionVersions ContributionVersion[] @relation("ContributionVersionAuthor")
  createdSources     Source[] @relation("SourceCreator")
  createdSourceVersions SourceVersion[] @relation("SourceVersionCreator")
  evidenceCreated    Evidence[] @relation("EvidenceCreator")
  claimsCreated      Claim[] @relation("ClaimCreator")
  annotations        Annotation[]
  reviewsAuthored    Review[] @relation("ReviewAuthor")
  reviewsRequested   Review[] @relation("ReviewRequester")
  reviewItems        ReviewItem[]
  rebuttals          Rebuttal[]
  decisions          Decision[]
  drafts             Draft[]
  snapshots          DraftSnapshot[]
  pendingMutations   PendingMutation[]
  assistantTasks     AssistantTask[]
  notifications      UserNotification[]
  notificationDeliveries NotificationDelivery[]
  attentionItems     AttentionItem[]
  activityEvents     UserActivityEvent[]
  activityDays       ResearchActivityDay[]
  reputationEvents   ReputationEvent[] @relation("ReputationRecipient")
  reputationActions  ReputationEvent[] @relation("ReputationActor")
  libraryItems       LibraryItem[]
  libraryCollections LibraryCollection[]
  auditEvents        AuditEvent[]
  integrityEvents    IntegrityEvent[] @relation("IntegrityIssuer")
  integrityReviews   IntegrityImpactRecord[] @relation("IntegrityReviewer")
  createdTools       ToolRepository[]
  projectNotes       ProjectNote[]
  discussionThreads  DiscussionThread[] @relation("DiscussionThreadCreator")
  discussionComments DiscussionComment[] @relation("DiscussionCommentAuthor")
  researchGoals      ResearchGoal[]
  savedSearches      SavedSearch[]
  citationCollections CitationCollection[]
  userFollowing      UserFollow[] @relation("UserFollower")
  userFollowers      UserFollow[] @relation("UserFollowed")
  topicFollows       TopicFollow[]
  toolFollows        ToolFollow[]
  projectFollows     ProjectFollow[]
  devices            UserDevice[]
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  username            String   @unique
  displayName         String
  biography           String?
  avatarUrl           String?
  location            String?
  primaryLanguage     String   @default("en")
  languages           String[] @default([])
  orcid               String?  @unique
  personalUrl         String?
  githubUsername      String?
  gitlabUsername      String?
  profileVisibility   Visibility @default(PUBLIC)
  metricsVisibility   Visibility @default(PUBLIC)
  activityVisibility  Visibility @default(WORKSPACE)
  profileCompleteness Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliations        ProfileAffiliation[]
  expertise           ProfileExpertise[]
  dashboardPreference DashboardPreference?
  modulePreferences   DashboardModulePreference[]
  metrics             ProfileMetrics?

  @@index([createdAt])
}

model ProfileAffiliation {
  id           String   @id @default(cuid())
  profileId    String
  organization String
  rorId        String?
  role         String?
  department   String?
  startsAt     DateTime?
  endsAt       DateTime?
  verification VerificationState @default(UNVERIFIED)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isPrimary])
  @@index([rorId])
}

model ProfileExpertise {
  id           String   @id @default(cuid())
  profileId    String
  taxonomyId   String
  kind         ExpertiseKind
  level        ExpertiseLevel?
  verification VerificationState @default(SELF_DECLARED)
  evidenceUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topic        Topic @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  @@unique([profileId, taxonomyId, kind])
  @@index([taxonomyId, kind])
}

model Workspace {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  slug           String   @unique
  description    String?
  status         WorkspaceStatus @default(ACTIVE)
  classification DataClassification @default(WORKSPACE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner          User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members        WorkspaceMember[]
  projects       ResearchProject[]
  contributions  Contribution[]
  sources        Source[]
  evidence       Evidence[]
  claims         Claim[]
  reviews        Review[]
  drafts         Draft[]
  attentionItems AttentionItem[]
  activities     UserActivityEvent[]
  auditEvents    AuditEvent[]
  integrityEvents IntegrityEvent[]
  assistantTasks AssistantTask[]
  workspaceTools WorkspaceTool[]
  projectNotes   ProjectNote[]
  discussionThreads DiscussionThread[]
  researchGoals  ResearchGoal[]

  @@index([ownerId, status])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, role])
}

// ============================================================
// DASHBOARD PREFERENCES, LIBRARY, FOLLOWS
// ============================================================

model DashboardPreference {
  id                String   @id @default(cuid())
  profileId         String   @unique
  defaultPersona    DashboardPersona @default(RESEARCHER)
  compactNavigation Boolean  @default(false)
  showAttentionRail Boolean  @default(true)
  timezone          String   @default("Asia/Dhaka")
  weekStartsOn      Int      @default(6)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model DashboardModulePreference {
  id            String   @id @default(cuid())
  profileId     String
  moduleKey     String
  position      Int
  visibility    ModuleVisibility @default(VISIBLE)
  size          ModuleSize @default(MEDIUM)
  configuration Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, moduleKey])
  @@unique([profileId, position])
}

model LibraryCollection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       LibraryItem[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model LibraryItem {
  id             String   @id @default(cuid())
  userId         String
  objectId       String
  objectType     LibraryObjectType
  collectionId   String?
  savedAt        DateTime @default(now())
  lastOpenedAt   DateTime?
  readState      ReadState @default(UNREAD)
  progress       Int?
  personalNote   String?
  tags           String[] @default([])
  classification DataClassification @default(WORKSPACE)

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection     LibraryCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, objectId, objectType])
  @@index([userId, savedAt])
  @@index([userId, readState])
  @@index([collectionId])
}

model ToolRepository {
  id                String   @id @default(cuid())
  createdBy         String
  host              ToolRepositoryHost
  owner             String
  name              String
  canonicalUrl      String   @unique
  description       String?
  defaultBranch     String?
  licenseSpdx       String?
  primaryLanguage   String?
  archived          Boolean  @default(false)
  latestRelease     String?
  lastPushedAt      DateTime?
  importMetadata    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator           User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  workspaces        WorkspaceTool[]
  sourceLinks       ToolSourceLink[]
  topics            ToolTopic[]
  followers         ToolFollow[]

  @@unique([host, owner, name])
  @@index([updatedAt])
}

model WorkspaceTool {
  id               String   @id @default(cuid())
  workspaceId      String
  toolRepositoryId String
  addedBy          String
  classification   DataClassification @default(WORKSPACE)
  addedAt          DateTime @default(now())

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolRepository   ToolRepository @relation(fields: [toolRepositoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, toolRepositoryId])
  @@index([toolRepositoryId])
}

model ProjectNote {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String?
  authorId       String
  title          String?
  document       Json
  mdx            String?
  classification DataClassification @default(WORKSPACE)
  version        Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        ResearchProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author         User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, updatedAt])
  @@index([projectId])
  @@index([authorId, updatedAt])
}

// ============================================================
// PROJECTS
// ============================================================

model ResearchProject {
  id             String   @id @default(cuid())
  workspaceId    String
  ownerId        String
  title          String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  stage          ProjectStage @default(DISCOVERY)
  progress       Int      @default(0)
  classification DataClassification @default(WORKSPACE)
  startsAt       DateTime?
  targetAt       DateTime?
  completedAt    DateTime?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members        ProjectMember[]
  milestones     ProjectMilestone[]
  tasks          ProjectTask[]
  objects        ProjectObject[]
  contributions  Contribution[]
  notes          ProjectNote[]

  @@index([workspaceId, status])
  @@index([ownerId, updatedAt])
  @@index([targetAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  joinedAt  DateTime @default(now())

  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, projectId])
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  completedAt DateTime?
  position    Int

  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
  @@index([dueAt, status])
}

model ProjectTask {
  id         String   @id @default(cuid())
  projectId  String
  assigneeId String?
  createdBy  String
  title      String
  status     TaskStatus @default(TODO)
  priority   TaskPriority @default(MEDIUM)
  dueAt      DateTime?
  objectId   String?
  objectType String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    User @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([projectId, status, priority])
  @@index([assigneeId, status])
}

model ProjectObject {
  id         String   @id @default(cuid())
  projectId  String
  objectId   String
  objectType ProjectObjectType
  addedBy    String
  addedAt    DateTime @default(now())

  project    ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, objectId, objectType])
  @@index([projectId, objectType])
}

// ============================================================
// SOURCES, IDENTIFIERS, INTEGRITY
// ============================================================

model Source {
  id               String   @id @default(cuid())
  workspaceId      String
  createdBy        String
  title             String
  translatedTitle  String?
  transliteratedTitle String?
  language          String   @default("en")
  type              SourceType
  currentVersionId  String?  @unique
  accessState       String?
  classification    DataClassification @default(WORKSPACE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator           User @relation("SourceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  currentVersion    SourceVersion? @relation("CurrentSourceVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions          SourceVersion[] @relation("SourceVersions")
  identifiers       ExternalIdentifier[]
  contributors      SourceContributor[]
  evidence          Evidence[]
  citations         Citation[]
  annotations       Annotation[]
  integrityEvents   IntegrityEvent[]
  topics            SourceTopic[]
  toolLinks         ToolSourceLink[]
  discussionThreads DiscussionThread[]
  citationCollectionItems CitationCollectionItem[]

  @@index([workspaceId, type])
  @@index([title])
}

model SourceVersion {
  id             String   @id @default(cuid())
  sourceId       String
  createdBy      String
  versionLabel   String
  publishedAt    DateTime?
  retrievedAt    DateTime?
  checksum       String?
  integrity      SourceIntegrity @default(ACTIVE)
  replacesId     String?
  contentLocator String?
  content        Json?
  createdAt      DateTime @default(now())

  source         Source @relation("SourceVersions", fields: [sourceId], references: [id], onDelete: Cascade)
  currentFor     Source? @relation("CurrentSourceVersion")
  creator        User @relation("SourceVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  replaces       SourceVersion? @relation("SourceVersionReplacement", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy     SourceVersion[] @relation("SourceVersionReplacement")
  evidence       Evidence[]
  citations      Citation[]
  annotations    Annotation[]
  integrityEvents IntegrityEvent[]

  @@unique([sourceId, versionLabel])
  @@index([sourceId, createdAt])
  @@index([integrity])
}

model ExternalIdentifier {
  id               String   @id @default(cuid())
  sourceId         String
  scheme           IdentifierScheme
  value            String
  normalizedValue  String
  canonicalUrl     String?
  sourceVersion    String?
  resolutionStatus IdentifierResolutionStatus @default(UNRESOLVED)
  resolvedAt       DateTime?

  source           Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([scheme, normalizedValue])
  @@index([sourceId, scheme])
}

model SourceContributor {
  id          String   @id @default(cuid())
  sourceId    String
  name        String
  orcid       String?
  role        String?
  affiliation String?
  position    Int

  source      Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, position])
  @@index([orcid])
}

model IntegrityEvent {
  id                String   @id @default(cuid())
  workspaceId       String
  sourceId          String
  sourceVersionId   String?
  issuedByUserId    String?
  type              IntegrityEventType
  issuingAuthority  String
  issuedAt          DateTime
  effectiveAt       DateTime
  noticeUrl         String?
  affectedLocators  Json?
  rationale         String?
  createdAt         DateTime @default(now())

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source            Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceVersion     SourceVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: SetNull)
  issuedBy          User? @relation("IntegrityIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  impacts           IntegrityImpactRecord[]

  @@index([sourceId, effectiveAt])
  @@index([type, effectiveAt])
}

model IntegrityImpactRecord {
  id               String   @id @default(cuid())
  eventId          String
  objectId         String
  objectType       String
  impact           IntegrityImpact
  status           IntegrityImpactStatus @default(OPEN)
  reviewerId       String?
  rationale        String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event            IntegrityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewer         User? @relation("IntegrityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([eventId, objectId, objectType])
  @@index([objectId, objectType, status])
}

// ============================================================
// EVIDENCE, CLAIMS, ASSESSMENTS, RELATIONSHIPS
// ============================================================

model Evidence {
  id               String   @id @default(cuid())
  workspaceId      String
  createdBy        String
  sourceId         String
  sourceVersionId  String
  statement        String
  locators         Json
  extractionType   AITransformationType
  quotation        String?
  structuredValue  Json?
  limitation       String?
  classification   DataClassification @default(WORKSPACE)
  version          Int @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator          User @relation("EvidenceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  source           Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceVersion    SourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  assessment       EvidenceAssessment?
  aiProvenance     AIProvenance?
  annotations      Annotation[]
  claimLinks       ClaimEvidence[]
  contributionLinks ContributionEvidence[]
  discussionThreads DiscussionThread[]

  @@index([workspaceId, updatedAt])
  @@index([sourceVersionId])
}

model EvidenceAssessment {
  id              String   @id @default(cuid())
  evidenceId      String   @unique
  review          ReviewLevel @default(NOT_REVIEWED)
  replication     ReplicationLevel @default(NOT_ASSESSED)
  certainty       CertaintyLevel @default(MODERATE)
  consensus       ConsensusLevel @default(UNKNOWN)
  sourceIntegrity SourceIntegrity @default(ACTIVE)
  assessedBy      String
  assessedAt      DateTime
  method          String
  rationale       String?
  previous        Json?

  evidence        Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
}

model Claim {
  id               String   @id @default(cuid())
  workspaceId      String
  createdBy        String
  text             String
  type             ClaimType
  classification   DataClassification @default(WORKSPACE)
  version          Int @default(1)
  responsibleReviewerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator          User @relation("ClaimCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  assessment       ClaimAssessment?
  annotations      Annotation[]
  evidenceLinks    ClaimEvidence[]
  contributionLinks ContributionClaim[]
  topics           ClaimTopic[]
  discussionThreads DiscussionThread[]

  @@index([workspaceId, updatedAt])
  @@index([type])
}

model ClaimAssessment {
  id                 String   @id @default(cuid())
  claimId            String   @unique
  review             ReviewLevel @default(NOT_REVIEWED)
  replication        ReplicationLevel @default(NOT_ASSESSED)
  certainty          CertaintyLevel @default(MODERATE)
  consensus          ConsensusLevel @default(UNKNOWN)
  sourceIntegrity    SourceIntegrity @default(ACTIVE)
  evidenceCount      Int @default(0)
  contradictionCount Int @default(0)
  assessedBy         String
  assessedAt         DateTime
  method             String
  rationale          String?
  lastRecomputedAt   DateTime
  previous           Json?

  claim              Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
}


// ============================================================
// CONTRIBUTIONS, CITATIONS, REVIEWS
// ============================================================

model Contribution {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String?
  authorId       String
  type           ContributionType
  status         ContributionStatus @default(DRAFT)
  title          String
  slug           String?
  summary        String?
  currentVersion Int      @default(1)
  classification DataClassification @default(WORKSPACE)
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        ResearchProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author         User @relation("ContributionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  versions       ContributionVersion[]
  citations      Citation[]
  reviews        Review[]
  drafts         Draft[]
  impactDaily    ContributionImpactDaily[]
  aiProvenance   AIProvenance[]
  evidenceLinks  ContributionEvidence[]
  claimLinks     ContributionClaim[]
  topics         ContributionTopic[]
  discussionThreads DiscussionThread[]
  citationCollectionItems CitationCollectionItem[]

  @@unique([workspaceId, slug])
  @@index([authorId, status, updatedAt])
  @@index([workspaceId, type, status])
}

model ContributionVersion {
  id             String   @id @default(cuid())
  contributionId String
  version        Int
  authorId       String
  document       Json
  mdx            String?
  changeSummary  String?
  checksum       String?
  createdAt      DateTime @default(now())

  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  author         User @relation("ContributionVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([contributionId, version])
  @@index([authorId, createdAt])
}

model Citation {
  id              String   @id @default(cuid())
  contributionId  String
  sourceId        String
  sourceVersionId String?
  style           String?
  locator         Json?
  resolution      CitationResolutionStatus @default(UNRESOLVED)
  entailment      CitationEntailment @default(NOT_ASSESSED)
  quotationMatch  QuotationMatchStatus @default(NOT_APPLICABLE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contribution    Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  source          Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceVersion   SourceVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: SetNull)

  @@unique([contributionId, sourceId, sourceVersionId])
  @@index([sourceId, resolution])
}

model Review {
  id              String   @id @default(cuid())
  workspaceId     String
  contributionId  String?
  reviewerId      String
  requestedById   String
  status          ReviewStatus @default(REQUESTED)
  recommendation  ReviewRecommendation?
  summary         String?
  requestedAt     DateTime @default(now())
  dueAt           DateTime?
  submittedAt     DateTime?
  closedAt        DateTime?
  anonymous       Boolean @default(false)
  version         Int @default(1)

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contribution    Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  reviewer        User @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  requester       User @relation("ReviewRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  items           ReviewItem[]
  rebuttals       Rebuttal[]
  decisions       Decision[]

  @@index([reviewerId, status, dueAt])
  @@index([contributionId, status])
}

model ReviewItem {
  id          String   @id @default(cuid())
  reviewId    String
  authorId    String
  objectId    String?
  objectType  String?
  title       String?
  body        String
  status      ReviewItemStatus @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  review      Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author      User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  rebuttals   Rebuttal[]

  @@index([reviewId, status])
}

model Rebuttal {
  id           String   @id @default(cuid())
  reviewId     String
  reviewItemId String?
  authorId     String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  review       Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewItem   ReviewItem? @relation(fields: [reviewItemId], references: [id], onDelete: SetNull)
  author       User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
}

model Decision {
  id         String   @id @default(cuid())
  reviewId   String
  authorId   String
  outcome    DecisionOutcome
  rationale  String
  createdAt  DateTime @default(now())

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author     User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
}

// ============================================================
// EDITOR, AUTOSAVE, ANNOTATIONS
// ============================================================

model Draft {
  id             String   @id @default(cuid())
  workspaceId    String
  contributionId String?
  ownerId        String
  title          String
  document       Json
  mdx            String?
  status         DraftStatus @default(ACTIVE)
  saveState      SaveState @default(SAVED)
  version        Int @default(1)
  classification DataClassification @default(WORKSPACE)
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contribution   Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  snapshots      DraftSnapshot[]
  mutations      PendingMutation[]

  @@index([ownerId, status, updatedAt])
  @@index([contributionId])
}

model DraftSnapshot {
  id        String   @id @default(cuid())
  draftId   String
  authorId  String
  version   Int
  document  Json
  mdx       String?
  reason    SnapshotReason
  createdAt DateTime @default(now())

  draft     Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([draftId, version])
  @@index([draftId, createdAt])
}

model PendingMutation {
  id            String   @id @default(cuid())
  mutationId    String   @unique
  draftId       String
  userId        String
  baseVersion   Int
  payload       Json
  status        MutationStatus @default(PENDING)
  attemptCount  Int @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  draft         Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([draftId, status, createdAt])
  @@index([status, nextAttemptAt])
}

model Annotation {
  id              String   @id @default(cuid())
  authorId        String
  sourceId        String?
  sourceVersionId String?
  evidenceId      String?
  claimId         String?
  type            AnnotationType
  status          AnnotationStatus @default(ACTIVE)
  body            String?
  anchor          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author          User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  source          Source? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceVersion   SourceVersion? @relation(fields: [sourceVersionId], references: [id], onDelete: SetNull)
  evidence        Evidence? @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  claim           Claim? @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([sourceVersionId, status])
  @@index([evidenceId])
  @@index([claimId])
}

// ============================================================
// AI, DASHBOARD, NOTIFICATIONS, ANALYTICS, AUDIT
// ============================================================

model AIProvenance {
  id                 String   @id @default(cuid())
  contributionId     String?
  evidenceId         String?  @unique
  provider           String
  model              String
  modelVersion       String?
  operation          AIOperationType
  transformationType AITransformationType
  promptTemplateVersion String?
  retrievedAt        DateTime?
  sourceIds          String[] @default([])
  toolCalls          Json?
  generatedAt        DateTime @default(now())
  sourceResolution   CitationResolutionStatus @default(UNRESOLVED)
  citationEntailment CitationEntailment @default(NOT_ASSESSED)
  quotationMatch     QuotationMatchStatus @default(NOT_APPLICABLE)
  humanReview        HumanReviewStatus @default(NOT_REVIEWED)
  externalProcessing ExternalProcessingPolicy @default(APPROVED_PROVIDER)
  reviewedBy         String?
  reviewedAt         DateTime?
  notes              String?

  contribution       Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  evidence           Evidence? @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([contributionId, generatedAt])
  @@index([humanReview, sourceResolution])
}

model AssistantTask {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  type        AssistantTaskType
  status      AssistantTaskStatus @default(PENDING)
  title       String
  explanation String?
  objectId    String?
  objectType  String?
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
}

model ContributionImpactDaily {
  id                String   @id @default(cuid())
  contributionId    String
  ownerId           String
  date              DateTime
  views             Int @default(0)
  saves             Int @default(0)
  references        Int @default(0)
  helpfulVotes      Int @default(0)
  evidenceReuse     Int @default(0)
  discussionReplies Int @default(0)

  contribution      Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([contributionId, date])
  @@index([ownerId, date])
}

model ReputationEvent {
  id          String   @id @default(cuid())
  userId      String
  type        ReputationEventType
  objectId    String
  objectType  String
  actorId     String?
  weight      Decimal @default(1.0)
  explanation String
  occurredAt  DateTime @default(now())
  reversedAt  DateTime?

  recipient   User @relation("ReputationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor       User? @relation("ReputationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([objectId, objectType])
}

model UserActivityEvent {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  eventType   String
  objectId    String?
  objectType  String?
  projectId   String?
  metadata    Json?
  occurredAt  DateTime @default(now())
  visibility  Visibility @default(PRIVATE)

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([projectId, occurredAt])
}

model AttentionItem {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  kind        AttentionKind
  severity    AttentionSeverity
  objectId    String
  objectType  String
  title       String
  explanation String
  actionLabel String
  actionHref  String
  status      AttentionStatus @default(OPEN)
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, status, severity])
  @@index([dueAt, status])
}

model UserNotification {
  id               String   @id @default(cuid())
  userId           String
  type             NotificationType
  objectId         String?
  objectType       String?
  title            String
  body             String
  actionHref       String?
  deduplicationKey String?
  readAt           DateTime?
  createdAt        DateTime @default(now())
  classification   DataClassification @default(WORKSPACE)

  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries       NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@unique([userId, deduplicationKey])
}

model NotificationDelivery {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attemptedAt    DateTime?
  deliveredAt    DateTime?
  error          String?

  notification   UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([userId, status])
}

model ResearchActivityDay {
  id                  String   @id @default(cuid())
  userId              String
  date                DateTime
  meaningfulActions   Int @default(0)
  contributionActions Int @default(0)
  reviewActions       Int @default(0)
  projectActions      Int @default(0)

  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String
  action      AuditAction
  objectId    String?
  objectType  String?
  occurredAt  DateTime @default(now())
  outcome     AuditOutcome
  reasonCode  String?
  metadata    Json?

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([objectId, objectType])
}

// ============================================================
// MOBILE EXPERIENCE, DEVICE PREFERENCES, PUSH, OFFLINE SYNC
// ============================================================

model UserDevice {
  id                     String   @id @default(cuid())
  userId                 String
  deviceKey               String
  deviceName              String?
  platform                DevicePlatform
  formFactor              DeviceFormFactor
  browser                 String?
  browserVersion          String?
  operatingSystem         String?
  operatingSystemVersion  String?
  locale                  String   @default("en")
  timezone                String?
  viewportWidth           Int?
  viewportHeight          Int?
  devicePixelRatio        Float?
  prefersReducedMotion    Boolean  @default(false)
  prefersHighContrast     Boolean  @default(false)
  prefersDarkMode         Boolean  @default(false)
  forcedColorsActive      Boolean  @default(false)
  lastSeenAt              DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  preference              MobileExperiencePreference?
  pushSubscriptions       PushSubscription[]
  syncCursors             DeviceSyncCursor[]

  @@unique([userId, deviceKey])
  @@index([userId, lastSeenAt])
  @@index([platform, formFactor])
}

model MobileExperiencePreference {
  id                         String   @id @default(cuid())
  deviceId                   String   @unique
  navigationMode             MobileNavigationMode @default(BOTTOM_NAV)
  defaultLanding             MobileLandingDestination @default(DASHBOARD)
  compactHeader              Boolean  @default(false)
  showBottomNavigation       Boolean  @default(true)
  showSyncStatus             Boolean  @default(true)
  dashboardDensity           MobileDensity @default(COMFORTABLE)
  editorToolbarMode          MobileEditorToolbarMode @default(CONTEXTUAL)
  sourceSheetSnapPoint       Int      @default(75)
  assistantSheetSnapPoint    Int      @default(75)
  reviewSheetSnapPoint       Int      @default(60)
  rememberLastDashboardTab   Boolean  @default(true)
  rememberLastEditorPanel    Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  device                     UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  dashboardModules           MobileDashboardModulePreference[]

  @@index([navigationMode, defaultLanding])
}

model MobileDashboardModulePreference {
  id                         String   @id @default(cuid())
  mobilePreferenceId         String
  moduleKey                  String
  position                   Int
  visibility                 ModuleVisibility @default(VISIBLE)
  presentation               MobileModulePresentation @default(CARD)
  collapsed                  Boolean  @default(false)
  configuration              Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  mobilePreference           MobileExperiencePreference @relation(fields: [mobilePreferenceId], references: [id], onDelete: Cascade)

  @@unique([mobilePreferenceId, moduleKey])
  @@unique([mobilePreferenceId, position])
}

model PushSubscription {
  id                         String   @id @default(cuid())
  userId                     String
  deviceId                   String
  endpoint                   String   @unique
  p256dh                     String
  auth                       String
  status                     PushSubscriptionStatus @default(ACTIVE)
  integrityAlertsEnabled     Boolean  @default(true)
  reviewNotificationsEnabled Boolean  @default(true)
  projectNotificationsEnabled Boolean @default(true)
  contributionNotificationsEnabled Boolean @default(true)
  quietHoursStartMinutes     Int?
  quietHoursEndMinutes       Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  revokedAt                  DateTime?

  user                       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device                     UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, status])
}

model DeviceSyncCursor {
  id                         String   @id @default(cuid())
  deviceId                   String
  workspaceId                String
  resourceType               SyncResourceType
  cursor                     String?
  lastSuccessfulSyncAt       DateTime?
  lastAttemptAt              DateTime?
  state                      DeviceSyncState @default(IDLE)
  pendingCount               Int      @default(0)
  lastErrorCode              String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  device                     UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, workspaceId, resourceType])
  @@index([workspaceId, state])
  @@index([deviceId, pendingCount])
}

enum DevicePlatform {
  ANDROID
  IOS
  WINDOWS
  MACOS
  LINUX
  CHROMEOS
  UNKNOWN
}

enum DeviceFormFactor {
  PHONE
  FOLDABLE
  TABLET
  DESKTOP
  LARGE_DESKTOP
  UNKNOWN
}

enum MobileNavigationMode {
  BOTTOM_NAV
  DRAWER_ONLY
  COMPACT_RAIL
}

enum MobileLandingDestination {
  DASHBOARD
  EXPLORE
  LIBRARY
  CONTRIBUTIONS
  PROJECTS
}

enum MobileDensity {
  COMPACT
  COMFORTABLE
  SPACIOUS
}

enum MobileEditorToolbarMode {
  CONTEXTUAL
  FIXED
  MINIMAL
}

enum MobileModulePresentation {
  CARD
  COMPACT_LIST
  HORIZONTAL_LIST
  SEGMENTED_SUMMARY
  TIMELINE
}

enum PushSubscriptionStatus {
  ACTIVE
  PAUSED
  REVOKED
  EXPIRED
}

enum SyncResourceType {
  DRAFT
  LIBRARY
  PROJECT
  CONTRIBUTION
  SOURCE
  EVIDENCE
  CLAIM
  REVIEW
  NOTIFICATION
}

enum DeviceSyncState {
  IDLE
  SYNCING
  OFFLINE
  FAILED
  CONFLICT
}

// ============================================================
// V3.4 NORMALIZED KNOWLEDGE, TOPICS, DISCUSSIONS, GOALS, SEARCH
// ============================================================

model ClaimEvidence {
  claimId         String
  evidenceId      String
  relationship    ClaimEvidenceType
  assertedBy      String
  assertionMethod RelationshipAssertionMethod @default(MANUAL)
  confidence      Decimal?
  rationale       String?
  status          RelationshipStatus @default(ACCEPTED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  claim           Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence        Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@id([claimId, evidenceId, relationship])
  @@index([evidenceId, relationship])
  @@index([claimId, status])
}

model ContributionEvidence {
  contributionId String
  evidenceId     String
  addedBy        String
  createdAt      DateTime @default(now())

  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  evidence       Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@id([contributionId, evidenceId])
  @@index([evidenceId])
}

model ContributionClaim {
  contributionId String
  claimId        String
  addedBy        String
  createdAt      DateTime @default(now())

  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  claim          Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@id([contributionId, claimId])
  @@index([claimId])
}

model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  language    String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outgoing    TopicRelationship[] @relation("TopicRelationshipSource")
  incoming    TopicRelationship[] @relation("TopicRelationshipTarget")
  sources     SourceTopic[]
  contributions ContributionTopic[]
  claims      ClaimTopic[]
  tools       ToolTopic[]
  followers   TopicFollow[]
  profileExpertise ProfileExpertise[]

  @@index([name])
}

model TopicRelationship {
  sourceTopicId String
  targetTopicId String
  type          TopicRelationType
  createdAt     DateTime @default(now())

  sourceTopic   Topic @relation("TopicRelationshipSource", fields: [sourceTopicId], references: [id], onDelete: Cascade)
  targetTopic   Topic @relation("TopicRelationshipTarget", fields: [targetTopicId], references: [id], onDelete: Cascade)

  @@id([sourceTopicId, targetTopicId, type])
  @@index([targetTopicId, type])
}

model SourceTopic {
  sourceId   String
  topicId    String
  confidence Decimal?
  assignedBy String?
  createdAt  DateTime @default(now())

  source     Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  topic      Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([sourceId, topicId])
  @@index([topicId])
}

model ContributionTopic {
  contributionId String
  topicId        String
  confidence     Decimal?

  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  topic          Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([contributionId, topicId])
  @@index([topicId])
}

model ClaimTopic {
  claimId    String
  topicId    String
  confidence Decimal?

  claim      Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  topic      Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([claimId, topicId])
  @@index([topicId])
}

model ToolTopic {
  toolRepositoryId String
  topicId          String
  confidence       Decimal?

  toolRepository   ToolRepository @relation(fields: [toolRepositoryId], references: [id], onDelete: Cascade)
  topic            Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([toolRepositoryId, topicId])
  @@index([topicId])
}

model DiscussionThread {
  id             String   @id @default(cuid())
  workspaceId    String?
  contributionId String?
  sourceId       String?
  claimId        String?
  evidenceId     String?
  createdBy      String
  lockedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contribution   Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  source         Source? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  claim          Claim? @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence       Evidence? @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  creator        User @relation("DiscussionThreadCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  comments       DiscussionComment[]

  @@index([contributionId, updatedAt])
  @@index([sourceId, updatedAt])
  @@index([claimId, updatedAt])
  @@index([evidenceId, updatedAt])
}

model DiscussionComment {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  parentId  String?
  body      String
  status    DiscussionCommentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime?

  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User @relation("DiscussionCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parent    DiscussionComment? @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   DiscussionComment[] @relation("DiscussionReplies")

  @@index([threadId, createdAt])
  @@index([parentId])
}

model ResearchGoal {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String?
  projectId    String?
  title        String
  description  String?
  metric       ResearchGoalMetric
  targetValue  Int
  currentValue Int @default(0)
  period       ResearchGoalPeriod
  startsAt     DateTime
  endsAt       DateTime?
  status       ResearchGoalStatus @default(ACTIVE)
  visibility   Visibility @default(PRIVATE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      ResearchProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progress     ResearchGoalProgress[]

  @@index([userId, status, endsAt])
  @@index([projectId, status])
}

model ResearchGoalProgress {
  id          String   @id @default(cuid())
  goalId      String
  date        DateTime
  value       Int
  sourceEvent String?
  createdAt   DateTime @default(now())

  goal        ResearchGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, date, sourceEvent])
  @@index([goalId, date])
}

model ToolSourceLink {
  id               String   @id @default(cuid())
  toolRepositoryId String
  sourceId         String
  releaseTag       String?
  commitSha        String?
  packageVersion   String?
  archivedUrl      String?
  observedAt       DateTime @default(now())

  toolRepository   ToolRepository @relation(fields: [toolRepositoryId], references: [id], onDelete: Cascade)
  source           Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([toolRepositoryId, sourceId])
  @@index([sourceId])
}

model ProfileMetrics {
  profileId              String   @id
  helpfulReviews         Int @default(0)
  referencedContributions Int @default(0)
  evidenceReuse          Int @default(0)
  acceptedCorrections    Int @default(0)
  replicationReports     Int @default(0)
  completedReviews       Int @default(0)
  recalculatedAt         DateTime @default(now())

  profile                UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  name        String
  query       String
  filters     Json?
  searchMode  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts      SearchAlert[]

  @@unique([userId, name])
  @@index([workspaceId, updatedAt])
}

model SearchAlert {
  id            String   @id @default(cuid())
  savedSearchId String
  frequency     AlertFrequency
  enabled       Boolean @default(true)
  lastRunAt     DateTime?
  lastTriggeredAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId])
  @@index([enabled, frequency])
}

model CitationCollection {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String?
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     ResearchProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items       CitationCollectionItem[]

  @@index([userId, updatedAt])
  @@index([projectId])
}

model CitationCollectionItem {
  collectionId String
  sourceId     String?
  contributionId String?
  note         String?
  position     Int
  createdAt    DateTime @default(now())

  collection   CitationCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  source       Source? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@id([collectionId, position])
  @@index([sourceId])
  @@index([contributionId])
}

model UserFollow {
  followerId String
  followedId String
  createdAt  DateTime @default(now())

  follower   User @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User @relation("UserFollowed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
}

model TopicFollow {
  userId    String
  topicId   String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
}

model ToolFollow {
  userId           String
  toolRepositoryId String
  createdAt        DateTime @default(now())

  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolRepository   ToolRepository @relation(fields: [toolRepositoryId], references: [id], onDelete: Cascade)

  @@id([userId, toolRepositoryId])
  @@index([toolRepositoryId])
}

model ProjectFollow {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

// GraphNode and GraphEdge are rebuildable projections, never canonical truth.
model GraphNode {
  id          String   @id
  workspaceId String?
  objectId    String
  objectType  GraphNodeType
  label       String
  classification DataClassification @default(WORKSPACE)
  payload     Json?
  updatedAt   DateTime @updatedAt

  outgoing    GraphEdge[] @relation("GraphEdgeFrom")
  incoming    GraphEdge[] @relation("GraphEdgeTo")

  @@unique([objectType, objectId])
  @@index([workspaceId, objectType])
}

model GraphEdge {
  id               String   @id @default(cuid())
  fromNodeId       String
  toNodeId         String
  relationshipType RelationshipType
  sourceRecordId   String?
  confidence       Decimal?
  payload          Json?
  updatedAt        DateTime @updatedAt

  fromNode         GraphNode @relation("GraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode           GraphNode @relation("GraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, relationshipType, sourceRecordId])
  @@index([toNodeId, relationshipType])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  key         String
  scope       String
  userId      String
  requestHash String
  statusCode  Int
  response    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id          String   @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  attempts    Int @default(0)
  lastError   String?

  @@index([status, createdAt])
}

model BackgroundJob {
  id          String   @id @default(cuid())
  type        String
  status      BackgroundJobStatus @default(PENDING)
  payload     Json
  result      Json?
  error       String?
  attempts    Int @default(0)
  runAfter    DateTime @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAfter])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payloadHash String
  status      WebhookDeliveryStatus @default(RECEIVED)
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

